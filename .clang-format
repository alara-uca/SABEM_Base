# Configuración de clang-format para NXP MCXA156

# Estilo base: K&R modificado
BasedOnStyle: Google

# Idioma: C
Language: Cpp
Standard: c++11

# ===== INDENTACIÓN =====
# 2 espacios (NO tabs)
UseTab: Never
IndentWidth: 2
TabWidth: 2
ContinuationIndentWidth: 4

# ===== LONGITUD DE LÍNEA =====
# Máximo 100 caracteres por línea
ColumnLimit: 100

# ===== LÍNEAS EN BLANCO =====
# Línea en blanco después de la llave de apertura de funciones
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 2
EmptyLineAfterAccessModifier: Never
EmptyLineBeforeAccessModifier: LogicalBlock

# ===== LLAVES (K&R Style) =====
# Llave de apertura en la misma línea
BreakBeforeBraces: Attach
# Insertar llaves donde el estándar no las requiere (clang-format >= 15)
# Garantiza que todo if/for/while/do tenga bloque explícito
InsertBraces: true

# ===== ESPACIADO =====
# Espacios alrededor de operadores
SpaceBeforeAssignmentOperators: true
SpaceAfterCStyleCast: true
SpaceAfterLogicalNot: false
SpacesInParens: Never
SpacesInSquareBrackets: false
SpacesInAngles: Never
SpacesInContainerLiterals: false
SpaceAroundPointerQualifiers: Default

# Espacio después de palabras clave (if, while, for)
# Sin espacio antes de paréntesis en llamadas a función
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterForeachMacros: true
  AfterFunctionDefinitionName: false
  AfterFunctionDeclarationName: false
  AfterIfMacros: true
  AfterOverloadedOperator: false
  AfterRequiresInClause: false
  AfterRequiresInExpression: false
  BeforeNonEmptyParentheses: false

# ===== ALINEACIÓN =====
# Alinear parámetros en llamadas multilínea
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments:
  Enabled: true
  AlignCompound: true
  PadOperators: true
AlignConsecutiveDeclarations:
  Enabled: true
  AlignFunctionDeclarations: false
AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: false

AlignEscapedNewlines: Right
AlignOperands: Align
AlignTrailingComments:
  Kind: Always

# ===== PUNTEROS Y REFERENCIAS =====
# int *ptr; (puntero junto al nombre, no al tipo)
PointerAlignment: Right
DerivePointerAlignment: false

# ===== COMENTARIOS =====
# Preservar comentarios y su formato
ReflowComments: Never

# ===== FORMATO DE FUNCIONES =====
# Permitir múltiples parámetros por línea
AllowAllParametersOfDeclarationOnNextLine: true
# Funciones cortas: no colapsar en una sola línea
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# ===== BREAK Y WRAPPING =====
# Romper líneas largas de forma inteligente
BreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false
BreakStringLiterals: true

# Penalizaciones para decisiones de formato
PenaltyBreakAssignment: 2
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyExcessCharacter: 1000000
PenaltyReturnTypeOnItsOwnLine: 60

# ===== INCLUDES (recomendado para embebido C) =====
# Si tu clang-format no soporta valores extendidos, usa: SortIncludes: true
SortIncludes:
  Enabled: true
  IgnoreCase: true
IncludeBlocks: Merge

# Detecta mejor cabecera principal asociada al .c
#IncludeIsMainRegex: '(_lpc40xx)?$'
IncludeIsMainSourceRegex: '(main_.*|.*)\.c$'

# Orden por grupos:
# 1) Cabecera principal asociada al .c (detectada automáticamente) (comillas)
# 2) SDK (fsl_*), CMSIS / startup / system (comillas o ángulos)
# 3) Librería estándar de C (ángulos)
# 4) Cabeceras de configuración de la placa y la aplicación (comillas)
# 5) Cabeceras generales tipos / lcd / error (comillas)
# 6) Cabeceras restantes del proyecto (comillas)
IncludeCategories:
  - Regex: '^[<"](fsl_.*|core_cm33|system_.*)\.h[>"]$'
    Priority: 1
    SortPriority: 1
  - Regex: '^<[^>]+>$'
    Priority: 2
    SortPriority: 2
  - Regex: '^"(app|board|clock_config|peripherals|pin_mux)\.h"$'
    Priority: 3
    SortPriority: 3
  - Regex: '^"(tipos|error|lcd(_(lvgl|panel|tactil))?)\.h"$'
    Priority: 4
    SortPriority: 4
  - Regex: '^"[^"]+"$'
    Priority: 5
    SortPriority: 5

# ===== MACROS Y PREPROCESADOR =====
# Indentar directivas del preprocesador como código normal (no al margen)
IndentPPDirectives: BeforeHash

# ===== SWITCHES =====
# Indentar case dentro de switch
IndentCaseLabels: true
IndentCaseBlocks: false

# ===== OTRAS OPCIONES =====
# Mantener formato de arrays/inicializadores
Cpp11BracedListStyle: true
BinPackArguments: true
BinPackParameters: BinPack
PackConstructorInitializers: Never

# Formato de declaraciones consecutivas
AlignConsecutiveBitFields: None

# Formato de goto labels
IndentGotoLabels: true

# Formato de lambdas y bloques
LambdaBodyIndentation: Signature
IndentWrappedFunctionNames: false

# ===== CONFIGURACIÓN ESPECÍFICA PARA C =====
# Permitir declaraciones de puntero múltiple en una línea
# Ejemplo: int *a, *b;
AllowAllArgumentsOnNextLine: true

# ===== COMENTARIOS ESPECIALES =====
# No reformatear bloques especiales (Doxygen)
CommentPragmas: '^ IWYU pragma:'

# ===== FINAL =====
